APP_ORIGIN=http://localhost:5174
AUTH_HOST=127.0.0.1
AUTH_PORT=8001
AUTH_COOKIE_SECURE=false

ARANGO_URL=http://127.0.0.1:8530
ARANGO_DATABASE=skill_graph_v366_acceptance
ARANGO_USERNAME=replace-with-limited-runtime-user
ARANGO_PASSWORD=replace-with-arango-runtime-password

# Dùng console để cả nhóm test quên mật khẩu mà không cần chia sẻ tài khoản email.
MAIL_MODE=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-smtp-account
SMTP_PASSWORD=your-app-password
SMTP_FROM=SkillGraph <no-reply@example.com>
